# 应用基础配置 (所有环境共享的默认值)
VITE_APP_TITLE=Amos
VITE_APP_VERSION=0.1.0

# 服务端配置 (会被 .env.development / .env.production 覆盖)
VITE_APP_SERVER_URL=http://localhost:3002
VITE_APP_API_TIMEOUT=30000

# Mock 开关 (默认关闭，开发环境可在 .env.development 中开启)
VITE_APP_ENABLE_MOCK=false

# 悬浮球配置
VITE_APP_FLOATING_MODE=window

# 功能开关
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ENABLE_DEBUG=false
