# 开发环境配置
NODE_ENV=development

# 应用配置
VITE_APP_TITLE=AMOS(Dev)
VITE_APP_VERSION=0.1.0-dev

# 服务端配置
VITE_APP_SERVER_URL=http://localhost:3002
VITE_APP_API_TIMEOUT=60000

# Mock 开关 (true: 使用mock数据, false: 使用真实API)
VITE_APP_ENABLE_MOCK=false

# 悬浮球配置 - 开发环境默认使用window模式
VITE_APP_FLOATING_MODE=window

# 功能开关
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ENABLE_DEBUG=true
