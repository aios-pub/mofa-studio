# 环境变量示例文件
# 复制此文件为 .env.local 或 .env.development.local 进行本地配置

# 应用基础配置
VITE_APP_TITLE=Amos-Claw
VITE_APP_VERSION=0.1.0

# API 配置
VITE_APP_API_BASE_URL=http://localhost:3000
VITE_APP_API_TIMEOUT=30000

# 悬浮球配置
# floating: 悬浮球模式 - 小球悬浮在屏幕上
# window: 普通窗口模式 (默认) - 使用标准桌面窗口
VITE_APP_FLOATING_MODE=window

# 功能开关
VITE_APP_ENABLE_ANALYTICS=false
VITE_APP_ENABLE_DEBUG=true
