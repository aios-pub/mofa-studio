# 生产环境配置
NODE_ENV=production

# 应用配置
VITE_APP_TITLE=AMOS
VITE_APP_VERSION=0.1.0

# 服务端配置
VITE_APP_SERVER_URL=https://agentos.aios.pub
VITE_APP_API_TIMEOUT=30000

# Mock 开关 (生产环境禁用mock)
VITE_APP_ENABLE_MOCK=false

# 悬浮球配置 - 生产环境默认使用普通窗口模式
VITE_APP_FLOATING_MODE=window

# 功能开关
VITE_APP_ENABLE_ANALYTICS=true
VITE_APP_ENABLE_DEBUG=false
