# 生产环境配置
NODE_ENV=production

# 应用配置
VITE_APP_TITLE=Amos-Claw
VITE_APP_VERSION=0.1.0

# API 配置 - 生产环境请修改为实际地址
VITE_APP_API_BASE_URL=https://api.example.com
VITE_APP_API_TIMEOUT=30000

# 悬浮球配置 - 生产环境默认使用普通窗口模式
VITE_APP_FLOATING_MODE=window

# 功能开关
VITE_APP_ENABLE_ANALYTICS=true
VITE_APP_ENABLE_DEBUG=false
