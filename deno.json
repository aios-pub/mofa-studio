{
  "tasks": {
    "install": "deno install",
    "dev": "deno run --allow-all --node-modules-dir=auto npm:vite",
    "build": "deno run --allow-all --node-modules-dir=auto npm:vite build",
    "preview": "deno run --allow-all --node-modules-dir=auto npm:vite preview",
    "tauri-dev": "deno run --allow-all npm:@tauri-apps/cli dev",
    "tauri-build": "deno run --allow-all npm:@tauri-apps/cli build"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "nodeModulesDir": "auto",
  "unstable": ["bare-node-builtins", "byonm"]
}
