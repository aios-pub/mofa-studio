{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mofa-studio",
  "version": "0.1.0",
  "identifier": "com.aios.mofa-studio",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "mofa-studio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": true
      },
      {
        "label": "floating",
        "title": "mofa-studio Floating",
        "url": "floating.html",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "focusable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["app-config.json"]
  }
}
